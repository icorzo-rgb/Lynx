# Configuración de Conexión a Supabase para LYNX
# Obtén estos valores en tu panel de Supabase: Project Settings > API

# URL de tu proyecto de Supabase (Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave pública anónima (anon / public key).
# SEGURO PARA EL FRONTEND: Esta clave solo permite las acciones autorizadas por Row Level Security (RLS).
# NUNCA uses aquí la clave 'service_role'.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
